# Secrets — AI4Good Workspace
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env. Ele está no .gitignore.

# ── Overleaf ──────────────────────────────────────────────────────────────────
# Token de autenticação Git do Overleaf
# Para gerar: Overleaf → Account Settings → Git Integration → Generate Token
OVERLEAF_GIT_TOKEN=

# URL do projeto Overleaf (sem o token)
OVERLEAF_PROJECT_URL=https://git.overleaf.com/6a920a859c5f584768569a70

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token do GitHub (se usar autenticação por token ao invés de SSH)
# Escopos necessários: repo, workflow
GITHUB_TOKEN=

# ── Google Gemini API ────────────────────────────────────────────────────────
# Chave de API do Google AI Studio (https://aistudio.google.com/)
# Necessária para o experimento distopia/utopia (agentes multimodelo)
GEMINI_API_KEY=

# ── Outros ───────────────────────────────────────────────────────────────────
# Adicione aqui outros segredos conforme necessário
